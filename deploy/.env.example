# Production environment for the Mercury stack. Copy to .env and fill in.
#
#   cp .env.example .env
#
# Every value is consumed by compose.yaml. Nothing here has a safe default; the ones that look
# harmless (BETTER_AUTH_SECRET, COOKIE_DOMAIN) are the ones that break SSO in confusing ways.

# --- Shared: the database ----------------------------------------------------------------------
# One Postgres for both apps. It is not published to the host; only the app containers reach it,
# over the compose network, which is why `db` is the hostname below.
POSTGRES_USER=mercury
POSTGRES_PASSWORD=            # generate: openssl rand -base64 24
POSTGRES_DB=mercury
DATABASE_URL=postgres://mercury:CHANGEME@db:5432/mercury

# --- Shared: the session ------------------------------------------------------------------------
# BETTER_AUTH_SECRET must be byte-identical in both apps. If it differs by one character, a session
# minted by financials is rejected by tokenomics with no useful error, and you will spend an
# afternoon on it.
BETTER_AUTH_SECRET=           # generate: openssl rand -base64 32

# The parent domain the session cookie is scoped to. This is what makes one login valid on both
# apps. It must be the parent of BOTH origins below, with the leading dot.
COOKIE_DOMAIN=.cardano-mercury.com

# --- The two public origins ---------------------------------------------------------------------
# Must be https and must match the hostnames in the Caddyfile exactly. adapter-node builds absolute
# URLs from these; Better Auth then checks callbacks against them.
FINANCIALS_ORIGIN=https://demo-financials.cardano-mercury.com
TOKENOMICS_ORIGIN=https://demo-tokenomics.cardano-mercury.com

# Where Let's Encrypt sends expiry warnings. A real address you actually read.
ACME_EMAIL=admin@cardano-mercury.com

# --- Core --------------------------------------------------------------------------------------
# The published version of @cardano-mercury/core whose shared auth migrations get applied. Pin it:
# this is the schema of record for the user/session/account/verification/two_factor tables.
CORE_VERSION=0.2.1

# --- financials only ----------------------------------------------------------------------------
# Chain data. Without a project id the wallet sync cannot run.
BLOCKFROST_NETWORK=mainnet
BLOCKFROST_PROJECT_ID=

# One instance is one entity; there is no multi-user team concept by design.
FINANCIALS_SINGLE_USER_MODE=true
# A public, read-only view so reviewers can see real statements with no account. Every write path
# stays behind the session check.
FINANCIALS_DEMO_MODE=true

# --- tokenomics only ----------------------------------------------------------------------------
# Magic-link sign-in needs a real SMTP transport. Left empty, tokenomics' email transport is a
# console.log stub and magic links go nowhere, so sign-in by magic link is simply broken.
SMTP_URL=

# --- Build contexts -----------------------------------------------------------------------------
# financials installs core from npm, so it builds from its own directory alone.
FINANCIALS_CONTEXT=../../mercury-financials

# tokenomics still depends on core via `file:../mercury-core`, so its build context must be the
# PARENT directory holding all the repos, and the deploy host must have them checked out as
# siblings. Once tokenomics moves to the published package, change these two to:
#   TOKENOMICS_CONTEXT=../../mercury-tokenomics
#   TOKENOMICS_DOCKERFILE=Dockerfile
TOKENOMICS_CONTEXT=../..
TOKENOMICS_DOCKERFILE=mercury-tokenomics/Dockerfile
