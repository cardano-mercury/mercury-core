# Production environment for the Mercury stack. Copy to .env and fill in.
#
#   cp .env.example .env
#
# Every value is consumed by compose.yaml. Nothing here has a safe default; the ones that look
# harmless (BETTER_AUTH_SECRET, COOKIE_DOMAIN) are the ones that break SSO in confusing ways.

# --- Which apps to run ---------------------------------------------------------------------------
# Both by default. Drop one to run the other alone:
#
#   COMPOSE_PROFILES=financials     # financials + postgres + redis + caddy
#   COMPOSE_PROFILES=tokenomics     # tokenomics + postgres + caddy (no redis; it does not use it)
#
# The shared Postgres, the core-migrate one-shot and Caddy always run. Redis rides the financials
# profile, since tokenomics has no queue. If you disable an app, its hostname answers 502 until you
# switch it back on, so drop its DNS record too if that matters.
COMPOSE_PROFILES=financials,tokenomics

# --- Shared: the database ----------------------------------------------------------------------
# One Postgres for both apps. It is not published to the host; only the app containers reach it,
# over the compose network, which is why `db` is the hostname below.
POSTGRES_USER=mercury
POSTGRES_PASSWORD=            # generate: openssl rand -base64 24
POSTGRES_DB=mercury
DATABASE_URL=postgres://mercury:CHANGEME@db:5432/mercury

# --- Shared: the session ------------------------------------------------------------------------
# BETTER_AUTH_SECRET must be byte-identical in both apps. If it differs by one character, a session
# minted by financials is rejected by tokenomics with no useful error, and you will spend an
# afternoon on it.
BETTER_AUTH_SECRET=           # generate: openssl rand -base64 32

# The parent domain the session cookie is scoped to. This is what makes one login valid on both
# apps. It must be the parent of BOTH origins below, with the leading dot.
COOKIE_DOMAIN=.cardano-mercury.com

# --- The domain ---------------------------------------------------------------------------------
# Set your two hostnames here and nowhere else. Caddy reads them for its site addresses and its TLS
# certificates, and each app's ORIGIN is derived from them in compose.yaml. Change these and the
# whole stack follows; there is no Caddyfile to edit.
#
# Point both at this host with A (and AAAA) records BEFORE bringing the stack up.
FINANCIALS_HOST=demo-financials.cardano-mercury.com
TOKENOMICS_HOST=demo-tokenomics.cardano-mercury.com

# Where Let's Encrypt sends expiry warnings. A real address you actually read.
ACME_EMAIL=admin@cardano-mercury.com

# --- Core --------------------------------------------------------------------------------------
# The published version of @cardano-mercury/core whose shared auth migrations get applied. Pin it:
# this is the schema of record for the user/session/account/verification/two_factor tables.
CORE_VERSION=0.2.1

# --- financials only ----------------------------------------------------------------------------
# Chain data. Without a project id the wallet sync cannot run.
BLOCKFROST_NETWORK=mainnet
BLOCKFROST_PROJECT_ID=

# One instance is one entity; there is no multi-user team concept by design.
FINANCIALS_SINGLE_USER_MODE=true
# A public, read-only view so reviewers can see real statements with no account. Every write path
# stays behind the session check.
FINANCIALS_DEMO_MODE=true

# --- tokenomics only ----------------------------------------------------------------------------
# Magic-link sign-in needs a real SMTP transport. Left empty, tokenomics hides the magic-link path
# entirely and serves email/password plus TOTP, which is a perfectly good production posture.
SMTP_URL=
# Sender for those emails. Defaults to "Mercury Tokenomics <no-reply@cardano-mercury.com>".
MAIL_FROM=

# --- Images -------------------------------------------------------------------------------------
# The app services pull these rather than building. Pin the tags for a real deploy: `latest` gives
# you whatever was pushed last, which is not a thing you want to discover during a demo.
REGISTRY=ghcr.io
GHCR_OWNER=cardano-mercury
FINANCIALS_TAG=latest
TOKENOMICS_TAG=latest

# Only needed if you layer compose.build.yaml on to build from source instead of pulling.
FINANCIALS_CONTEXT=../../mercury-financials
TOKENOMICS_CONTEXT=../../mercury-tokenomics
TOKENOMICS_DOCKERFILE=Dockerfile
