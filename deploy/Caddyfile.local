# Local dry run. Same routing as production, but Caddy signs certificates with its own internal CA
# instead of talking to Let's Encrypt, so this needs no public DNS, no VPS, and no open ports.
#
# The hostnames end in `.localhost`, which Chrome and Firefox resolve to 127.0.0.1 on their own. No
# hosts-file editing. (curl does not, hence the --resolve in the README.)
#
# The parent domain still matters: the session cookie is scoped to .mercury.localhost, and that is
# what makes one login valid on both apps. This is the same mechanism as production, just a
# different parent, so a local run genuinely exercises SSO rather than faking it.

{
	# No ACME, no email needed. Caddy mints a local CA and signs both hosts from it.
	local_certs
}

demo-financials.mercury.localhost {
	encode gzip
	reverse_proxy financials:3000 {
		health_uri /healthz
		health_interval 5s
		health_timeout 2s
	}
}

demo-tokenomics.mercury.localhost {
	encode gzip
	reverse_proxy tokenomics:3000 {
		health_uri /healthz
		health_interval 5s
		health_timeout 2s
	}
}
