# Local dry run. Copy to .env.local and use with:
#
#   docker compose -f compose.yaml -f compose.local.yaml --env-file .env.local up -d --build
#
# No VPS, no DNS, no public ports. Caddy signs certs with its own internal CA, and the .localhost
# hostnames resolve to 127.0.0.1 in Chrome and Firefox without any hosts-file editing.
#
# The values below are throwaway. They are committed deliberately so a dry run is one command; do
# not reuse any of them anywhere real.

POSTGRES_USER=mercury
POSTGRES_PASSWORD=50bb71e19f1d77ab8383fe0b704f3cd8
POSTGRES_DB=mercury
DATABASE_URL=postgres://mercury:50bb71e19f1d77ab8383fe0b704f3cd8@db:5432/mercury

# Same secret in both apps, which is what makes the session portable between them.
BETTER_AUTH_SECRET=xoCm7HzJ9UcMJDW2eTvCTzw61ZxF4vw2YXAtEiKNRfc=

# The parent of both origins below. This is the mechanism SSO rides on, and it is the same
# mechanism as production, just a different parent domain.
COOKIE_DOMAIN=.mercury.localhost

FINANCIALS_ORIGIN=https://demo-financials.mercury.localhost
TOKENOMICS_ORIGIN=https://demo-tokenomics.mercury.localhost

CORE_VERSION=0.2.1

# Chain sync will not work without a real project id, but everything else (auth, SSO, the demo
# view, the reports) does. Fill it in if you want to sync a wallet.
BLOCKFROST_NETWORK=mainnet
BLOCKFROST_PROJECT_ID=

FINANCIALS_SINGLE_USER_MODE=true
FINANCIALS_DEMO_MODE=true

# compose.local.yaml points tokenomics at the mailpit sink, so this is overridden there.
SMTP_URL=

FINANCIALS_CONTEXT=../../mercury-financials
TOKENOMICS_CONTEXT=../../mercury-tokenomics
TOKENOMICS_DOCKERFILE=Dockerfile
