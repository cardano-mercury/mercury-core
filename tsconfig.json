{
	"compilerOptions": {
		"target": "ES2022",
		// NodeNext, not Bundler. The package is "type": "module", so dist/ is real ESM loaded by
		// Node's resolver, which requires a file extension on every relative import. Bundler mode let
		// tsc emit extensionless specifiers that only a bundler could resolve, which is how 0.2.0
		// shipped with unloadable `db` and `cardano` entry points. NodeNext makes tsc reject them at
		// compile time instead.
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"types": ["node"],
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src"]
}
