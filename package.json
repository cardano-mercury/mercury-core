{
	"name": "@cardano-mercury/core",
	"version": "0.2.2",
	"description": "Shared database schema, authentication, and Cardano utilities for the Mercury apps.",
	"keywords": [
		"cardano",
		"mercury",
		"better-auth",
		"drizzle",
		"blockfrost",
		"postgres"
	],
	"license": "Apache-2.0",
	"author": "Cardano Mercury, Inc.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cardano-mercury/mercury-core.git"
	},
	"homepage": "https://github.com/cardano-mercury/mercury-core#readme",
	"bugs": {
		"url": "https://github.com/cardano-mercury/mercury-core/issues"
	},
	"engines": {
		"node": ">=22"
	},
	"type": "module",
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"drizzle",
		"bin"
	],
	"bin": {
		"mercury-core": "./bin/mercury-core.js"
	},
	"exports": {
		"./db": {
			"types": "./dist/db/index.d.ts",
			"default": "./dist/db/index.js"
		},
		"./db/migrate": {
			"types": "./dist/db/migrate.d.ts",
			"default": "./dist/db/migrate.js"
		},
		"./auth": {
			"types": "./dist/auth/index.d.ts",
			"default": "./dist/auth/index.js"
		},
		"./cardano": {
			"types": "./dist/cardano/index.d.ts",
			"default": "./dist/cardano/index.js"
		},
		"./money": {
			"types": "./dist/money.d.ts",
			"default": "./dist/money.js"
		}
	},
	"scripts": {
		"prepublishOnly": "npm run build",
		"build": "tsc -p tsconfig.build.json",
		"smoke": "bash scripts/smoke-pack.sh",
		"dev": "tsc -p tsconfig.build.json --watch",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node bin/mercury-core.js migrate",
		"changeset": "changeset",
		"changeset:version": "changeset version"
	},
	"peerDependencies": {
		"@meshsdk/core": "*",
		"better-auth": "~1.6.23",
		"drizzle-orm": ">=0.40"
	},
	"dependencies": {
		"postgres": "^3.4.9"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@eslint/js": "^10.0.1",
		"@meshsdk/core": "^1.9.1",
		"@types/node": "^26",
		"@vitest/coverage-v8": "^4.1.10",
		"better-auth": "~1.6.23",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.1",
		"vitest": "^4.1.10"
	}
}
